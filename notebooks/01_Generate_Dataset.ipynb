import pandas as pd
import numpy as np

np.random.seed(42)

# Generate timestamps (30 days, 1-minute interval)
timestamps = pd.date_range(
    start="2025-01-01",
    periods=30 * 24 * 60,
    freq="min"
)

df = pd.DataFrame({
    "Timestamp": timestamps
})

# Normal operating metrics
df["CPU"] = np.random.normal(45, 10, len(df)).clip(10, 100)
df["Memory"] = np.random.normal(55, 8, len(df)).clip(20, 100)
df["Latency"] = np.random.normal(120, 25, len(df)).clip(50, 500)
df["Throughput"] = np.random.normal(500, 40, len(df)).clip(100, 700)
df["ErrorRate"] = np.random.normal(0.3, 0.15, len(df)).clip(0, 5)

# Incident column
df["Incident"] = 0

